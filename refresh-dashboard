#!/usr/bin/env bash
# refresh-dashboard — One-command MMC Dashboard data refresh
#
# Usage:
#   ./refresh-dashboard            # live data from BigQuery
#   ./refresh-dashboard --dry-run  # test pipeline without credentials
#   ./refresh-dashboard --help     # show all options
#
# This script:
#   1. Verifies Python 3 is available
#   2. Creates a local virtualenv (.venv-tools/) if needed
#   3. Installs tools/requirements.txt into the virtualenv
#   4. Verifies Google Cloud ADC credentials (unless --dry-run)
#   5. Runs tools/refresh_real_data.py
#   6. Runs the Node.js data validator as a final check
#
# Security:
#   Authentication uses Application Default Credentials (ADC).
#   Run "gcloud auth application-default login" to authenticate.
#   Do NOT commit .env, ADC files, or service-account keys.
#   Do NOT commit data/*.json without reviewing the output first.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv-tools"
PYTHON_MIN_MINOR=8  # Python 3.8+

# ── Colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[0;33m'
BLU='\033[0;34m'
RST='\033[0m'

info()    { echo -e "${BLU}→${RST}  $*"; }
success() { echo -e "${GRN}✓${RST}  $*"; }
warn()    { echo -e "${YLW}⚠${RST}  $*" >&2; }
die()     { echo -e "${RED}✗${RST}  $*" >&2; exit 1; }

# ── Detect --dry-run flag without consuming args ──────────────────────────────
DRY_RUN=0
for arg in "$@"; do
  [[ "$arg" == "--dry-run" ]] && DRY_RUN=1
done

# ── Python check ─────────────────────────────────────────────────────────────
if ! command -v python3 &>/dev/null; then
  die "python3 not found. Install Python 3.${PYTHON_MIN_MINOR}+ and try again."
fi

PY_VERSION=$(python3 -c "import sys; print(sys.version_info.minor)")
if [[ "$PY_VERSION" -lt "$PYTHON_MIN_MINOR" ]]; then
  die "Python 3.${PYTHON_MIN_MINOR}+ required (found 3.${PY_VERSION})."
fi
success "Python 3.${PY_VERSION} found"

# ── Virtualenv setup ──────────────────────────────────────────────────────────
if [[ ! -d "$VENV_DIR" ]]; then
  info "Creating virtualenv at .venv-tools/ …"
  python3 -m venv "$VENV_DIR"
  success "Virtualenv created"
fi

# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"

info "Checking Python dependencies …"
if pip install --quiet -r "$SCRIPT_DIR/tools/requirements.txt"; then
  success "Dependencies ready"
else
  die "pip install failed. Check your network / proxy settings."
fi

# ── Google Cloud credential check (skipped in dry-run) ───────────────────────
if [[ "$DRY_RUN" -eq 0 ]]; then
  info "Checking Google Cloud credentials (ADC) …"
  if ! python3 -c "
import sys
try:
    import google.auth
    creds, proj = google.auth.default()
    print(f'  Project hint: {proj or \"(none)\"}')
except Exception as e:
    print(f'  ERROR: {e}', file=sys.stderr)
    sys.exit(1)
  "; then
    echo >&2
    warn "No valid ADC credentials found."
    warn "Run: gcloud auth application-default login"
    warn "Then retry: ./refresh-dashboard"
    echo >&2
    die "Authentication failed."
  fi
  success "ADC credentials available"
else
  warn "DRY RUN — skipping credential check."
fi

# ── Run the refresh ───────────────────────────────────────────────────────────
echo
info "Starting refresh …"
echo

if ! python3 "$SCRIPT_DIR/tools/refresh_real_data.py" "$@"; then
  echo >&2
  die "Refresh failed. Previous data/ snapshot was preserved."
fi

# ── Final validation hint ─────────────────────────────────────────────────────
echo
success "Refresh complete."
echo
echo "  Review output:"
echo "    ls -la data/"
echo "    cat data/manifest.json"
echo "    cat data/p0-metrics.json | python3 -m json.tool | head -40"
echo
echo "  When satisfied — commit:"
echo "    git add data/"
echo "    git diff --staged | head -60   # spot-check diff"
echo "    git commit -m 'chore: refresh live metrics <date>'"
echo
