# MMC Dashboard refresh configuration
# Copy to .env and edit as needed. .env is gitignored.
#
# Authentication: uses Application Default Credentials (ADC), not a key file.
# Run: gcloud auth application-default login
# DO NOT set GOOGLE_APPLICATION_CREDENTIALS here.

BQ_PROJECT=sams-mmc-social-prod
BQ_DATASET=prod

# Optional: how many months of historical data to pull (default: 18)
# LOOKBACK_MONTHS=18
